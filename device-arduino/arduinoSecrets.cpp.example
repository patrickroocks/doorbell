// Example template for arduinoSecrets.cpp
// Copy this file to arduinoSecrets.cpp and fill in your real values.

#include "arduinoSecrets.h"


std::vector<MqttClientConfig> getMqttConfigs()
{
    std::vector<MqttClientConfig> mqttConfigs;
    mqttConfigs.push_back({.brokerAddress = "192.168.x.x", .brokerPort = 1883}); // Mosquitto on Raspi
    mqttConfigs.push_back({.brokerAddress = "localhost", .brokerPort = 1883});   // Local broker on ESP32
    return mqttConfigs;
}


std::vector<WifiConfig> getWifiConfigs()
{
    std::vector<WifiConfig> wifiConfigs;
    wifiConfigs.push_back({.ssid = "SSID1", .password = "PASSWORD1"});
    wifiConfigs.push_back({.ssid = "SSID2", .password = "PASSWORD2"});
    return wifiConfigs;
}
