// Example template for src/secretConfig.rs
// Copy this file to src/secretConfig.rs and fill in your real values.

// This corresponds to the API key in http-redirect/secrets.inc.php
pub const API_KEY: &str = "YOUR_API_KEY_HERE";

pub const DOORGATEWAY_ADDR: &str = "https://your-domain.example/doorgateway";

pub fn generateUploadURL(address: &str) -> String {
    format!("{}/setServerAddress.php?API_KEY={}&ADDRESS={}", DOORGATEWAY_ADDR, API_KEY, address)
}

pub fn getFetchURL() -> String {
    format!("{}", DOORGATEWAY_ADDR)
}
